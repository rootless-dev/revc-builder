+#ifdef RW_WGPU
+// reVC Builder: DXT data passes through to the wgpu renderer unchanged, since its
+// rasters are top-down like D3D's (no flipDXT).
+static rw::Raster*
+dxt_to_wgpu(rw::Raster *ras, int dxt, bool32 hasAlpha)
+{
+	using namespace rw;
+
+	if(dxt == 0 || !wgpu::caps.dxtSupported || ras->width % 4 || ras->height % 4)
+		return nil;
+
+	Raster *newras = Raster::create(ras->width, ras->height, ras->depth,
+		                        ras->format | Raster::TEXTURE | Raster::DONTALLOCATE);
+	int numLevels = ras->getNumLevels();
+	wgpu::allocateDXT(newras, dxt, numLevels, hasAlpha);
+	for(int i = 0; i < numLevels; i++){
+		// Blocks of 4x4 pixels; a level smaller than a block still takes one.
+		int32 w = ras->width >> i, h = ras->height >> i;
+		uint32 size = ((w+3)/4 > 0 ? (w+3)/4 : 1) * ((h+3)/4 > 0 ? (h+3)/4 : 1) * (dxt == 1 ? 8 : 16);
+		uint8 *srcpx = ras->lock(i, Raster::LOCKREAD);
+		uint8 *dstpx = newras->lock(i, Raster::LOCKWRITE | Raster::LOCKNOFETCH);
+		memcpy(dstpx, srcpx, size);
+		ras->unlock(i);
+		newras->unlock(i);
+	}
+	return newras;
+}
+
+static int
+d3dDxt(int32 format)
+{
+	switch(format){
+	case d3d::D3DFMT_DXT1: return 1;
+	case d3d::D3DFMT_DXT3: return 3;
+	case d3d::D3DFMT_DXT5: return 5;
+	}
+	return 0;
+}
+
+static int
+xboxDxt(int32 format)
+{
+	switch(format){
+	case xbox::D3DFMT_DXT1: return 1;
+	case xbox::D3DFMT_DXT3: return 3;
+	case xbox::D3DFMT_DXT5: return 5;
+	}
+	return 0;
+}
+#endif
+
 rw::Raster*
 Raster::convertTexToCurrentPlatform(rw::Raster *ras)
 {
@@ -528,6 +580,23 @@ Raster::convertTexToCurrentPlatform(rw::Raster *ras)
 			return newras;
 		}
 	}
+#ifdef RW_WGPU
+	else if((ras->platform == PLATFORM_D3D8 || ras->platform == PLATFORM_D3D9) && rw::platform == PLATFORM_WGPU){
+		d3d::D3dRaster *d3dras = GETD3DRASTEREXT(ras);
+		Raster *newras = dxt_to_wgpu(ras, d3dras->customFormat ? d3dDxt(d3dras->format) : 0, d3dras->hasAlpha);
+		if(newras){
+			ras->destroy();
+			return newras;
+		}
+	}else if(ras->platform == PLATFORM_XBOX && rw::platform == PLATFORM_WGPU){
+		xbox::XboxRaster *xboxras = GETXBOXRASTEREXT(ras);
+		Raster *newras = dxt_to_wgpu(ras, xboxras->customFormat ? xboxDxt(xboxras->format) : 0, xboxras->hasAlpha);
+		if(newras){
+			ras->destroy();
+			return newras;
+		}
+	}
+#endif
 
 	// fall back to going through Image directly
 	int32 width, height, depth, format;
