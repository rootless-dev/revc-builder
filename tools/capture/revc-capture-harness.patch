new file mode 100644
index 0000000..bd93b57
--- /dev/null
+++ b/src/core/capture.cpp
@@ -0,0 +1,69 @@
+// reVC Builder development harness for reproducible captures (Phase 2 design, section 10).
+#include "common.h"
+#include "Frontend.h"
+#include "Weather.h"
+#include "capture.h"
+
+static int captureState = -1;	// -1 unknown, 0 off, 1 on
+static unsigned long captureFrameNumber;
+static unsigned long newGameFrame, skipCutsceneFrame, weatherFrame;
+static int weather;
+
+static unsigned long
+envFrame(const char *name)
+{
+	const char *v = getenv(name);
+	return v ? strtoul(v, nil, 10) : 0;
+}
+
+bool
+CaptureActive(void)
+{
+	if(captureState < 0){
+		const char *v = getenv("REVC_CAPTURE");
+		captureState = v && v[0] == '1';
+		newGameFrame = envFrame("REVC_CAPTURE_NEWGAME");
+		skipCutsceneFrame = envFrame("REVC_CAPTURE_SKIPCUTSCENE");
+		// REVC_CAPTURE_WEATHER=<frame>:<weather>, e.g. 3000:2 for rain
+		const char *w = getenv("REVC_CAPTURE_WEATHER");
+		if(w)
+			sscanf(w, "%lu:%d", &weatherFrame, &weather);
+		if(captureState)
+			fprintf(stderr, "capture: fixed time step, no input, new game at %lu, skip cutscene at %lu\n",
+				newGameFrame, skipCutsceneFrame);
+	}
+	return captureState == 1;
+}
+
+void
+CaptureFrame(void)
+{
+	if(!CaptureActive())
+		return;
+	captureFrameNumber++;
+	if(captureFrameNumber == 2){
+		int w = 960, h = 540;
+		const char *size = getenv("REVC_CAPTURE_WINDOW");
+		if(size)
+			sscanf(size, "%dx%d", &w, &h);
+		CapturePlaceWindow(w, h);
+	}
+	if(captureFrameNumber == newGameFrame){
+		fprintf(stderr, "capture: frame %lu: starting a new game\n", captureFrameNumber);
+		FrontEndMenuManager.DoSettingsBeforeStartingAGame();
+	}
+	if(weatherFrame && captureFrameNumber == weatherFrame){
+		fprintf(stderr, "capture: frame %lu: weather %d\n", captureFrameNumber, weather);
+		CWeather::ForceWeatherNow(weather);
+	}
+}
+
+bool
+CaptureSkipCutsceneNow(void)
+{
+	if(CaptureActive() && captureFrameNumber == skipCutsceneFrame){
+		fprintf(stderr, "capture: frame %lu: skipping the cutscene\n", captureFrameNumber);
+		return true;
+	}
+	return false;
+}
diff --git a/src/core/capture.h b/src/core/capture.h
