--- /dev/null
+++ b/src/core/capture.h
@@ -0,0 +1,13 @@
+// reVC Builder development harness for reproducible captures (Phase 2 design, section 10).
+// Never part of a user build: tools/capture applies it to a development checkout.
+#pragma once
+
+// REVC_CAPTURE=1: fixed 1/30 s game clock steps, no keyboard, mouse or pad input.
+bool CaptureActive(void);
+// Called once per main-loop frame; starts a new game at frame REVC_CAPTURE_NEWGAME.
+void CaptureFrame(void);
+// True at frame REVC_CAPTURE_SKIPCUTSCENE: the running cutscene is skipped.
+bool CaptureSkipCutsceneNow(void);
+// Defined by the GLFW skeleton: moves the window to the primary monitor and resizes it
+// (REVC_CAPTURE_WINDOW=<width>x<height> in screen points, default 960x540).
+void CapturePlaceWindow(int width, int height);
