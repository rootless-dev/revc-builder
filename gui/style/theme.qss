/* reVC Builder: dark background, neon pink and cyan accents. Colours are original. */

QMainWindow, QWidget#Root {
    background-color: #0b0420;
}

QWidget {
    color: #f3ecff;
    font-size: 14px;
}

QLabel#Title {
    font-family: "Monoton";
    font-size: 40px;
    color: #ff3ea5;
}

QLabel#Heading {
    font-family: "Audiowide";
    font-size: 22px;
    color: #2de2e6;
}

QLabel#Body {
    color: #d9cff2;
    font-size: 14px;
}

QLabel#Muted {
    color: #9a8cc0;
    font-size: 12px;
}

QLabel#Good {
    color: #5bf5b5;
}

QLabel#Bad {
    color: #ff6b8b;
}

QLabel#Steps {
    font-family: "Audiowide";
    font-size: 12px;
    color: #7d6fa8;
}

QPushButton {
    font-family: "Audiowide";
    font-size: 14px;
    color: #2de2e6;
    background-color: transparent;
    border: 2px solid #2de2e6;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton:hover {
    color: #0b0420;
    background-color: #2de2e6;
}

QPushButton:pressed {
    background-color: #1fb1b4;
}

QPushButton:disabled {
    color: #4a3f6b;
    border-color: #4a3f6b;
}

QPushButton#Primary {
    color: #0b0420;
    background-color: #ff3ea5;
    border-color: #ff3ea5;
}

QPushButton#Primary:hover {
    background-color: #ff6fbf;
    border-color: #ff6fbf;
}

QPushButton#Primary:disabled {
    color: #4a3f6b;
    background-color: transparent;
    border-color: #4a3f6b;
}

QFrame#DropArea {
    border: 2px dashed #7d6fa8;
    border-radius: 10px;
    background-color: #140a33;
}

QFrame#DropArea[hover="true"] {
    border-color: #ff3ea5;
    background-color: #1d0f45;
}

QListWidget, QPlainTextEdit {
    background-color: #140a33;
    border: 1px solid #3a2d63;
    border-radius: 6px;
    color: #d9cff2;
    selection-background-color: #ff3ea5;
    selection-color: #0b0420;
}

QPlainTextEdit {
    font-family: "Menlo";
    font-size: 11px;
}

QProgressBar {
    background-color: #140a33;
    border: 1px solid #3a2d63;
    border-radius: 6px;
    height: 14px;
    text-align: center;
    color: #f3ecff;
}

QProgressBar::chunk {
    border-radius: 5px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff3ea5, stop:1 #2de2e6);
}

QScrollBar:vertical {
    background: #140a33;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #3a2d63;
    border-radius: 5px;
    min-height: 24px;
}
